run1_2025 <- run1_2025 %>%
  select(
    -any_of("sqrt_L1_L2")
  ) %>%
  mutate(
    Treatment = factor(
      Treatment,
      levels = treatment_order
    ),
    sqrt_L1_L2 = sqrt(
      Total_L1_L2 + 0.5
    )
  )

