# =========================================================
# 10. FUNCTION FOR CREATING EACH BOXPLOT
# =========================================================

make_boxplot <- function(
    data,
    letters,
    panel_title,
    y_axis = "left",
    show_x_labels = TRUE
) {
  
  plot <- ggplot(
    data,
    aes(
      x = Treatment,
      y = Total_L1_L2,
      fill = Treatment
    )
  ) +
    
    geom_boxplot(
      width = 0.6,
      color = "black",
      linewidth = 0.4,
      outlier.shape = 21,
      outlier.fill = "white",
      outlier.color = "black"
    ) +
    
    geom_text(
      data = letters,
      aes(
        x = Treatment,
        y = ypos,
        label = Letters
      ),
      inherit.aes = FALSE,
      size = 4,
      fontface = "plain"
    ) +
    
    scale_fill_manual(
      values = treatment_fills
    ) +
    
    labs(
      title = panel_title,
      x = NULL,
      y = NULL
    ) +
    
    coord_cartesian(
      ylim = c(
        0,
        65
      ),
      clip = "off"
    ) +
    
    theme_minimal(
      base_size = 14
    ) +
    
    theme(
      legend.position = "none",
      
      plot.title = element_text(
        size = 12,
        face = "bold",
        hjust = 0.5
      ),
      
      plot.margin = margin(
        t = 5,
        r = 5,
        b = 5,
        l = 5
      )
    )
  
  
  if (y_axis == "right") {
    
    plot <- plot +
      scale_y_continuous(
        position = "right"
      ) +
      theme(
        axis.title.y = element_blank(),
        axis.text.y.left = element_blank(),
        axis.ticks.y.left = element_blank(),
        axis.text.y.right = element_text(),
        axis.ticks.y.right = element_line()
      )
  }
  
  
  if (!show_x_labels) {
    
    plot <- plot +
      theme(
        axis.text.x = element_blank(),
        axis.ticks.x = element_blank()
      )
  }
  
  
  return(plot)
}


