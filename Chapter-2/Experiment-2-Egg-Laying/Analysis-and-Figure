# =========================================================
# 5. 2025 RUN 1
# =========================================================


# ---------------------------------------------------------
# INITIAL MODEL – UNTRANSFORMED DATA
# ---------------------------------------------------------

run1_2025_raw_model <- aov(
  Total_L1_L2 ~ Treatment,
  data = run1_2025
)

summary(
  run1_2025_raw_model
)

qqnorm(
  residuals(run1_2025_raw_model),
  main = "2025 Run 1 – Untransformed Residuals"
)

qqline(
  residuals(run1_2025_raw_model)
)

shapiro.test(
  residuals(run1_2025_raw_model)
)

leveneTest(
  Total_L1_L2 ~ Treatment,
  data = run1_2025
)


# ---------------------------------------------------------
# TRANSFORMED MODEL
# ---------------------------------------------------------

run1_2025_model <- aov(
  sqrt_L1_L2 ~ Treatment,
  data = run1_2025
)

qqnorm(
  residuals(run1_2025_model),
  main = "2025 Run 1 – Transformed Residuals"
)

qqline(
  residuals(run1_2025_model)
)

run1_2025_shapiro <- shapiro.test(
  residuals(run1_2025_model)
)

run1_2025_shapiro

run1_2025_levene <- leveneTest(
  sqrt_L1_L2 ~ Treatment,
  data = run1_2025
)

run1_2025_levene


# ---------------------------------------------------------
# FINAL ANALYSIS
# ---------------------------------------------------------

run1_2025_anova <- summary(
  run1_2025_model
)

run1_2025_anova

run1_2025_tukey <- TukeyHSD(
  run1_2025_model
)

run1_2025_tukey


