    columns = KW_p,
    decimals = 3
  ) %>%
  
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  
  tab_style(
    style = cell_text(
      weight = "bold"
    ),
    locations = cells_row_groups()
  ) %>%
  
  tab_options(
    row_group.as_column = FALSE
  )


