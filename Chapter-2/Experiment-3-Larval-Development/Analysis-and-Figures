# =========================================================
# 10. FUNCTION FOR LARVAL-AGE ANALYSIS
# =========================================================

# Average larval age was compared among moisture treatments
# separately at 14, 19, and 24 DPI using Kruskal-Wallis
# tests.

make_age_summary <- function(
    data,
    year_label
) {
  
  # -------------------------------------------------------
  # DESCRIPTIVE STATISTICS
  # -------------------------------------------------------
  
  descriptive <- data %>%
    filter(
      !is.na(Average_Age)
    ) %>%
    group_by(
      DPI,
      Treatment
    ) %>%
    summarise(
      n = n(),
      
      mean_age = mean(
        Average_Age
      ),
      
      sd_age = sd(
        Average_Age
      ),
      
      se_age = sd_age / sqrt(n),
      
      .groups = "drop"
    ) %>%
    mutate(
      Mean_SE = sprintf(
        "%.2f ± %.2f",
        mean_age,
        se_age
      )
    ) %>%
    select(
      DPI,
      Treatment,
      n,
      Mean_SE
    ) %>%
    pivot_wider(
      names_from = Treatment,
      values_from = c(
        n,
        Mean_SE
      )
    )
  
  
  # -------------------------------------------------------
  # KRUSKAL-WALLIS TESTS BY DPI
  # -------------------------------------------------------
  
  kw_results <- data %>%
    filter(
      !is.na(Average_Age)
    ) %>%
    group_split(
      DPI
    ) %>%
    map_dfr(
      function(dat) {
        
        kw <- kruskal.test(
          Average_Age ~ Treatment,
          data = dat
        )
        
        tibble(
          DPI = unique(
            dat$DPI
          ),
          
          KW_H = unname(
            kw$statistic
          ),
          
          KW_df = unname(
            kw$parameter
          ),
          
          KW_p = kw$p.value
        )
      }
    )
  
  
  # -------------------------------------------------------
  # COMBINE DESCRIPTIVE AND INFERENTIAL RESULTS
  # -------------------------------------------------------
  
  descriptive %>%
    left_join(
      kw_results,
      by = "DPI"
    ) %>%
    mutate(
      Year = year_label
    ) %>%
    select(
      Year,
      DPI,
      n_Low,
      n_Medium,
      n_High,
      Mean_SE_Low,
      Mean_SE_Medium,
      Mean_SE_High,
      KW_H,
      KW_df,
      KW_p
    )
}


