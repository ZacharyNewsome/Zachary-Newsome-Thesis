# =========================================================
# 11. 2025 PRIOR-REGULARIZED NEGATIVE-BINOMIAL GLMM
# =========================================================

# Near-zero larval recovery in the spinosad treatment
# produced extreme coefficient estimates in the standard
# negative-binomial model. Weakly informative priors were
# therefore applied to regularize the fixed-effect estimates.
#
# Intercept: normal(0, 5)
# Remaining fixed effects: normal(0, 3)

nb_priors_2025 <- data.frame(
  prior = c(
    "normal(0,5)",
    "normal(0,3)"
  ),
  
  class = c(
    "beta",
    "beta"
  ),
  
  coef = c(
    "(Intercept)",
    ""
  )
)


model_nb_prior_2025 <- update(
  model_nb_2025,
  priors = nb_priors_2025
)

summary(
  model_nb_prior_2025
)


