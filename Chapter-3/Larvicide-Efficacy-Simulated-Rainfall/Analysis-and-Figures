# =========================================================
# 24. CUSTOM Y-AXIS COMPRESSION
# =========================================================

# Values from 0 to 15 are displayed normally.
# Values above 15 are compressed to prevent large
# observations from stretching the figure vertically.

squish_upper <- function(x) {
  
  ifelse(
    x > 15,
    15 + (x - 15) * 0.25,
    x
  )
}


unsquish_upper <- function(x) {
  
  ifelse(
    x > 15,
    15 + (x - 15) / 0.25,
    x
  )
}


