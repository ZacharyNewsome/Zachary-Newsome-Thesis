# =========================================================
# 2. IMPORT RAW DATA
# =========================================================

rain_2025 <- read.csv(
  "SP25 Obj 4 Raw Data (No 6, 22).csv"
)

rain_2026 <- read.csv(
  "2026 Obj 4 Raw Data.csv"
)


# =========================================================
# 3. DEFINE COMMON FACTOR LEVELS
# =========================================================

# Product order is arranged from lowest to highest Koc,
# with the untreated control first.

product_order <- c(
  "control",
  "cyantraniliprole",
  "tetraniliprole",
  "spinosad",
  "isocycloseram",
  "novaluron"
)

rainfall_order <- c(
  "none",
  "medium",
  "high"
)


# =========================================================
# 4. PREPARE DATA
# =========================================================

rain_2025 <- rain_2025 %>%
  mutate(
    plot = factor(
      plot
    ),
    
    product = factor(
      product,
      levels = product_order
    ),
    
    rainfall = factor(
      rainfall,
      levels = rainfall_order
    )
  )


rain_2026 <- rain_2026 %>%
  mutate(
    plot = factor(
      plot
    ),
    
    product = factor(
      product,
      levels = product_order
    ),
    
    rainfall = factor(
      rainfall,
      levels = rainfall_order
    )
  )

# =========================================================
# PART I – 2025 STATISTICAL ANALYSIS
# =========================================================


# =========================================================
# 5. 2025 POISSON GLMM
# =========================================================

model_pois_2025 <- glmmTMB(
  total_L3_L5 ~ product * rainfall +
    (1 | plot),
  family = poisson(
    link = "log"
  ),
  data = rain_2025
)

summary(
  model_pois_2025
)


# ---------------------------------------------------------
# POISSON MODEL DIAGNOSTICS
# ---------------------------------------------------------

set.seed(
  123
)

res_pois_2025 <- simulateResiduals(
  fittedModel = model_pois_2025,
  n = 1000
)

testUniformity(
  res_pois_2025
)

testDispersion(
  res_pois_2025
)

testZeroInflation(
  res_pois_2025
)

testOutliers(
  res_pois_2025
)

check_overdispersion(
  model_pois_2025
)


# =========================================================
# 6. 2025 NEGATIVE-BINOMIAL GLMM
# =========================================================

# The negative-binomial model was fitted after evaluation
# of the Poisson model indicated inadequate fit.

model_nb_2025 <- glmmTMB(
  total_L3_L5 ~ product * rainfall +
    (1 | plot),
  family = nbinom2(
    link = "log"
  ),
  data = rain_2025
)

summary(
  model_nb_2025
)


# ---------------------------------------------------------
# MODEL CONVERGENCE
# ---------------------------------------------------------

model_nb_2025$fit$convergence

model_nb_2025$sdr$pdHess

VarCorr(
  model_nb_2025
)


